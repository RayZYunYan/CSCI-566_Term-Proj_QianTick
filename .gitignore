# ============================================================
# Large Data Files (too large for GitHub)
# ============================================================

# Raw news data from teammates (4~20MB each, total ~100MB+)
data/raw/news/

# Processed/merged news files (28~68MB each)
data/processed/news/

# Price feature engineering output (34MB)
data/processed/stock/features/all_features.csv

# Merged raw stock CSV (4.7MB, derived from individual CSVs)
data/raw/stock/all_stocks.csv

# Dataset splits - npz files (25~116MB each)
data/processed/stock/dataset/

# News article embeddings (2.67GB — too large)
data/features/news_article_embeddings.parquet

# news_features.parquet (50MB) and export_to_fusion/features/*.pt (10~20MB)
# are under GitHub's 100MB limit — allowed by default

# ============================================================
# Small files — explicitly ALLOW (override rules above if needed)
# ============================================================
# data/raw/stock/AAPL.csv etc.  (~200KB each) — allowed by default
# data/features/labels.parquet  (~small)       — allowed by default
# export_to_fusion/predictions/price_model_outputs.csv (~3MB) — allowed
# outputs/fusion/fusion_best.pt (~2.3MB)        — allowed
# src/price_prediction_pipeline/outputs/        — allowed

